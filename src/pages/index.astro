---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { byNewest, isVisible } from '../lib/content';
import mascotLight from '../assets/brand/mascot-light.png';
import mascotDark from '../assets/brand/mascot-dark.png';

const [projects, posts, notes] = await Promise.all([
  getCollection('projects', isVisible),
  getCollection('blog', isVisible),
  getCollection('notes', isVisible),
]);

const recentProjects = projects.sort(byNewest).slice(0, 2);
const recentPosts = posts.sort(byNewest).slice(0, 2);
const recentNotes = notes.sort(byNewest).slice(0, 2);
const hasRecentContent = recentProjects.length + recentPosts.length + recentNotes.length > 0;

const [lightMascot, darkMascot] = await Promise.all([
  getImage({ src: mascotLight, width: 560, height: 560, format: 'webp', quality: 82 }),
  getImage({ src: mascotDark, width: 560, height: 560, format: 'webp', quality: 82 }),
]);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span>Portfólio pessoal</span><span>01 / Início</span></p>
      <h1>Projetos, ideias e pensamentos em <em>construção.</em></h1>
      <p class="intro">
        Um espaço para apresentar meu trabalho, desenvolver ideias e registrar
        aprendizados ao longo do caminho.
      </p>

      <div class="actions">
        <a href="/projetos/">Ver projetos <span aria-hidden="true">→</span></a>
        <a href="/pensamentos/">Ler pensamentos <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <aside class="focus-card" aria-labelledby="focus-title">
      <picture class="mascot">
        <source media="(prefers-color-scheme: dark)" srcset={darkMascot.src} />
        <img
          src={lightMascot.src}
          width="560"
          height="560"
          alt="Mascote verde em forma de ave com símbolos de código"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div class="card-header">
        <p id="focus-title">Áreas de atuação</p>
        <span class="availability"><i></i> Em construção</span>
      </div>
      <ol>
        <li><span>01</span><strong>Inteligência artificial</strong><small>Modelos, dados e automação</small></li>
        <li><span>02</span><strong>Web scraping</strong><small>Coleta, escala e confiabilidade</small></li>
        <li><span>03</span><strong>Back-end</strong><small>APIs, processamento e sistemas</small></li>
      </ol>
    </aside>
  </section>

  <section class="recent" aria-labelledby="recent-title">
    <header class="section-header">
      <div>
        <p class="kicker">Registro recente</p>
        <h2 id="recent-title">Últimas publicações</h2>
      </div>
      <a href="/tags/">Explorar por tags →</a>
    </header>

    <div class="content-grid">
      {recentProjects.map((project) => (
        <ContentCard
          href={`/projetos/${project.id}/`}
          kind="Projeto"
          title={project.data.title}
          description={project.data.description}
          publishedAt={project.data.publishedAt}
          tags={project.data.stack}
        />
      ))}
      {recentPosts.map((post) => (
        <ContentCard
          href={`/blog/${post.id}/`}
          kind="Artigo"
          title={post.data.title}
          description={post.data.description}
          publishedAt={post.data.publishedAt}
          tags={post.data.tags}
        />
      ))}
      {recentNotes.map((note) => (
        <ContentCard
          href={`/pensamentos/${note.id}/`}
          kind="Pensamento"
          title={note.data.title}
          description={note.data.description}
          publishedAt={note.data.publishedAt}
          tags={note.data.tags}
          status={note.data.status}
        />
      ))}
      {!hasRecentContent && (
        <div class="empty-state"><p>O espaço está pronto para receber as primeiras publicações.</p></div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.75fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding: clamp(5rem, 12vw, 10rem) 0 clamp(5rem, 10vw, 8rem);
  }

  .eyebrow {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    max-width: 43rem;
    margin: 0 0 1.5rem;
    padding-top: 0.8rem;
    border-top: 0.2rem solid var(--accent);
    color: var(--muted);
    font: 700 0.72rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.4rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.89;
  }

  h1 em {
    color: var(--accent);
    font-weight: inherit;
  }

  .intro {
    max-width: 34rem;
    margin: 2.25rem 0;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }

  .actions a,
  .section-header > a {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
    font: 700 0.82rem/1.5 var(--ui);
    text-decoration: none;
  }

  .actions a span {
    color: var(--accent);
  }

  .focus-card {
    overflow: hidden;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper-raised) 92%, transparent);
    box-shadow: var(--shadow);
  }

  .mascot {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border-bottom: 1px solid var(--line);
    background: var(--paper-raised);
  }

  .mascot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--line);
    font: 700 0.66rem/1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-header p {
    margin: 0;
  }

  .availability {
    color: var(--muted);
  }

  .availability i {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.25rem;
    border-radius: 50%;
    background: var(--accent);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.2rem 0.75rem;
    padding: 1.25rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  li:last-child {
    border-bottom: 0;
  }

  li > span {
    grid-row: 1 / 3;
    color: var(--accent);
    font: 700 0.68rem/1.5 var(--mono);
  }

  li strong {
    font: 700 0.95rem/1.4 var(--ui);
  }

  li small {
    color: var(--muted);
    font: 500 0.76rem/1.5 var(--mono);
  }

  .recent {
    padding: 0 0 7rem;
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .section-header h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .section-header .kicker {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .focus-card {
      max-width: 32rem;
    }
  }

  @media (max-width: 34rem) {
    .eyebrow span:last-child {
      display: none;
    }

    h1 {
      font-size: clamp(3.3rem, 18vw, 5rem);
    }

    .section-header {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
