---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { byNewest, isVisible } from '../lib/content';
import mascotLight from '../assets/brand/g-dev-mascot-light.png';
import mascotDark from '../assets/brand/g-dev-mascot-dark.png';
import profilePhoto from '../../img/pedro-grangeiro-profile.jpg';

const [projects, posts, notes] = await Promise.all([
  getCollection('projects', isVisible),
  getCollection('blog', isVisible),
  getCollection('notes', isVisible),
]);

const recentProjects = projects.sort(byNewest).slice(0, 2);
const recentPosts = posts.sort(byNewest).slice(0, 2);
const recentNotes = notes.sort(byNewest).slice(0, 2);
const hasRecentContent = recentProjects.length + recentPosts.length + recentNotes.length > 0;

const [lightMascot, darkMascot, profile] = await Promise.all([
  getImage({ src: mascotLight, width: 560, height: 560, format: 'webp', quality: 82 }),
  getImage({ src: mascotDark, width: 560, height: 560, format: 'webp', quality: 82 }),
  getImage({ src: profilePhoto, width: 720, format: 'webp', quality: 84 }),
]);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span>Pedro Grangeiro · Rio de Janeiro</span><span>01 / Início</span></p>
      <h1>IA aplicada, dados e sistemas em <em>produção.</em></h1>
      <p class="intro">
        Sou AI Engineer e desenvolvedor back-end. Trabalho principalmente com Python,
        modelos de linguagem, automação e pipelines que transformam dados dispersos em sistemas confiáveis.
      </p>

      <div class="actions">
        <a href="/projetos/">Ver projetos <span aria-hidden="true">→</span></a>
        <a href="/sobre/">Conhecer meu trabalho <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <aside class="focus-card" aria-labelledby="focus-title">
      <div
        class="mascot"
        role="img"
        aria-label="Mascote G dev alternando com um retrato de Pedro Grangeiro"
      >
        <picture class="mascot-layer" aria-hidden="true">
          <source media="(prefers-color-scheme: dark)" srcset={darkMascot.src} />
          <img
            src={lightMascot.src}
            width="560"
            height="560"
            alt=""
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <img
          class="portrait-layer"
          src={profile.src}
          width={profile.attributes.width}
          height={profile.attributes.height}
          alt=""
          aria-hidden="true"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="card-header">
        <p id="focus-title">Áreas de atuação</p>
        <span class="availability"><i></i> Aprendizado contínuo</span>
      </div>
      <ol>
        <li><span>01</span><strong>Inteligência artificial</strong><small>Machine learning, LLMs e MLOps</small></li>
        <li><span>02</span><strong>Dados e automação</strong><small>Coleta, scraping e qualidade</small></li>
        <li><span>03</span><strong>Back-end</strong><small>Python, APIs e processamento</small></li>
      </ol>
    </aside>
  </section>

  <section class="recent" aria-labelledby="recent-title">
    <header class="section-header">
      <div>
        <p class="kicker">Registro recente</p>
        <h2 id="recent-title">Últimas publicações</h2>
      </div>
      <a href="/tags/">Explorar por tags →</a>
    </header>

    <div class="content-grid">
      {recentProjects.map((project) => (
        <ContentCard
          href={`/projetos/${project.id}/`}
          kind="Projeto"
          title={project.data.title}
          description={project.data.description}
          publishedAt={project.data.publishedAt}
          tags={project.data.stack}
        />
      ))}
      {recentPosts.map((post) => (
        <ContentCard
          href={`/blog/${post.id}/`}
          kind="Artigo"
          title={post.data.title}
          description={post.data.description}
          publishedAt={post.data.publishedAt}
          tags={post.data.tags}
        />
      ))}
      {recentNotes.map((note) => (
        <ContentCard
          href={`/pensamentos/${note.id}/`}
          kind="Pensamento"
          title={note.data.title}
          description={note.data.description}
          publishedAt={note.data.publishedAt}
          tags={note.data.tags}
          status={note.data.status}
        />
      ))}
      {!hasRecentContent && (
        <div class="empty-state"><p>O espaço está pronto para receber as primeiras publicações.</p></div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.75fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    padding: clamp(5rem, 12vw, 10rem) 0 clamp(5rem, 10vw, 8rem);
  }

  .eyebrow {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    max-width: 43rem;
    margin: 0 0 1.5rem;
    padding-top: 0.8rem;
    border-top: 0.2rem solid var(--accent);
    color: var(--muted);
    font: 700 0.72rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.4rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.89;
  }

  h1 em {
    color: var(--accent);
    font-weight: inherit;
  }

  .intro {
    max-width: 34rem;
    margin: 2.25rem 0;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }

  .actions a,
  .section-header > a {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--ink);
    font: 700 0.82rem/1.5 var(--ui);
    text-decoration: none;
  }

  .actions a span {
    color: var(--accent);
  }

  .focus-card {
    overflow: hidden;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper-raised) 92%, transparent);
    box-shadow: var(--shadow);
  }

  .mascot {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border-bottom: 1px solid var(--line);
    background: var(--paper-raised);
  }

  .mascot-layer {
    position: absolute;
    inset: 0;
    display: block;
    animation: mascot-reveal 10s ease-in-out infinite;
  }

  .mascot-layer img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-layer {
    position: absolute;
    top: 21%;
    left: 21%;
    display: block;
    width: 58%;
    height: 58%;
    border: clamp(0.28rem, 0.8vw, 0.5rem) solid #162d46;
    border-radius: 50%;
    object-fit: cover;
    object-position: 72% 38%;
    opacity: 0;
    box-shadow: 0 1rem 2.5rem rgb(18 31 45 / 0.22);
    transform: scale(0.84) rotate(-3deg);
    animation: portrait-reveal 10s ease-in-out infinite;
  }

  .mascot:hover .mascot-layer,
  .mascot:hover .portrait-layer {
    animation-play-state: paused;
  }

  @keyframes mascot-reveal {
    0%,
    38%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    48%,
    88% {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @keyframes portrait-reveal {
    0%,
    40%,
    100% {
      opacity: 0;
      transform: scale(0.84) rotate(-3deg);
    }

    50%,
    86% {
      opacity: 1;
      transform: scale(1) rotate(0);
    }

    94% {
      opacity: 0;
      transform: scale(0.92) rotate(2deg);
    }
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--line);
    font: 700 0.66rem/1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-header p {
    margin: 0;
  }

  .availability {
    color: var(--muted);
  }

  .availability i {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.25rem;
    border-radius: 50%;
    background: var(--accent);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.2rem 0.75rem;
    padding: 1.25rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  li:last-child {
    border-bottom: 0;
  }

  li > span {
    grid-row: 1 / 3;
    color: var(--accent);
    font: 700 0.68rem/1.5 var(--mono);
  }

  li strong {
    font: 700 0.95rem/1.4 var(--ui);
  }

  li small {
    color: var(--muted);
    font: 500 0.76rem/1.5 var(--mono);
  }

  .recent {
    padding: 0 0 7rem;
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .section-header h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .section-header .kicker {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .focus-card {
      max-width: 32rem;
    }
  }

  @media (max-width: 34rem) {
    .eyebrow span:last-child {
      display: none;
    }

    h1 {
      font-size: clamp(3.3rem, 18vw, 5rem);
    }

    .section-header {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot-layer,
    .portrait-layer {
      animation: none;
    }

    .portrait-layer {
      opacity: 0;
    }
  }
</style>
