---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { byNewest, isVisible } from '../../lib/content';

const posts = (await getCollection('blog', isVisible)).sort(byNewest);
---

<BaseLayout title="Blog" description="Artigos completos sobre engenharia de software, dados e inteligência artificial.">
  <div class="page-shell">
    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="kicker">02 / Ideias desenvolvidas</p>
        <h1 class="page-title">Blog</h1>
      </div>
      <p class="page-description">
        Textos longos sobre decisões, experimentos e aprendizados técnicos.
      </p>
    </header>

    <section class="content-grid" aria-label="Lista de artigos">
      {posts.length > 0 ? posts.map((post) => (
        <ContentCard
          href={`/blog/${post.id}/`}
          kind="Artigo"
          title={post.data.title}
          description={post.data.description}
          publishedAt={post.data.publishedAt}
          tags={post.data.tags}
        />
      )) : (
        <div class="empty-state">
          <p>O primeiro artigo ainda está sendo desenvolvido. Quando publicado, aparecerá aqui automaticamente.</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
