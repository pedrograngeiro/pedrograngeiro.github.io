---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { isVisible } from '../../lib/content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getCollection('projects', isVisible);

  return projects.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  tags={entry.data.tags}
  kind="Projeto"
  backHref="/projetos/"
  backLabel="Projetos"
>
  {(entry.data.role || entry.data.stack.length > 0 || entry.data.outcome || entry.data.repository || entry.data.demo || entry.data.article) && (
    <div slot="details" class="project-details">
      {(entry.data.role || entry.data.stack.length > 0 || entry.data.outcome) && (
        <dl class="project-facts">
          {entry.data.role && <div><dt>Papel</dt><dd>{entry.data.role}</dd></div>}
          {entry.data.stack.length > 0 && <div><dt>Stack</dt><dd>{entry.data.stack.join(' · ')}</dd></div>}
          {entry.data.outcome && <div><dt>Resultado</dt><dd>{entry.data.outcome}</dd></div>}
        </dl>
      )}
      {(entry.data.repository || entry.data.demo || entry.data.article) && (
        <div class="project-links">
          {entry.data.repository && <a href={entry.data.repository}>Ver repositório <span aria-hidden="true">↗</span></a>}
          {entry.data.article && <a href={entry.data.article}>Ver explicação técnica <span aria-hidden="true">↗</span></a>}
          {entry.data.demo && <a href={entry.data.demo}>Abrir demonstração <span aria-hidden="true">↗</span></a>}
        </div>
      )}
    </div>
  )}

  {entry.data.cover && <figure>
    <Image src={entry.data.cover} alt={entry.data.coverAlt ?? entry.data.title} widths={[720, 1080]} sizes="(max-width: 768px) calc(100vw - 2rem), 736px" />
    {entry.data.coverCaption && <figcaption>{entry.data.coverCaption}</figcaption>}
  </figure>}
  <Content />
</ContentLayout>

<style>
  .project-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border: 1px solid var(--line);
  }

  .project-facts div {
    padding: 1rem;
    border-right: 1px solid var(--line);
  }

  .project-facts div:last-child {
    border-right: 0;
  }

  dt {
    margin-bottom: 0.5rem;
    color: var(--muted);
    font: 700 0.65rem/1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font: 600 0.85rem/1.5 var(--ui);
  }

  .project-details {
    margin: 0 0 3rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-top: 1rem;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    font: 700 0.78rem/1.5 var(--ui);
    text-decoration: none;
  }

  .project-links span {
    color: var(--accent);
  }

  @media (max-width: 48rem) {
    .project-facts {
      grid-template-columns: 1fr;
    }

    .project-facts div {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .project-facts div:last-child {
      border-bottom: 0;
    }
  }
</style>
