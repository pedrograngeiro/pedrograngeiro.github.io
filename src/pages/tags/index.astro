---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContentIndex } from '../../lib/content';

const items = await getContentIndex();
const counts = items.reduce((map, item) => {
  item.tags.forEach((tag) => map.set(tag, (map.get(tag) ?? 0) + 1));
  return map;
}, new Map<string, number>());
const tags = [...counts.entries()].sort(([a], [b]) => a.localeCompare(b, 'pt-BR'));
---

<BaseLayout title="Tags" description="Assuntos que conectam projetos, artigos e pensamentos.">
  <div class="page-shell">
    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="kicker">Índice</p>
        <h1 class="page-title">Tags</h1>
      </div>
      <p class="page-description">Caminhos para encontrar conexões entre trabalhos e ideias.</p>
    </header>

    {tags.length > 0 ? (
      <ul class="tag-index">
        {tags.map(([tag, count]) => (
          <li><a href={`/tags/${tag}/`}><span>#{tag}</span><small>{count.toString().padStart(2, '0')}</small></a></li>
        ))}
      </ul>
    ) : (
      <div class="empty-state"><p>As tags aparecerão quando o primeiro conteúdo for publicado.</p></div>
    )}
  </div>
</BaseLayout>

<style>
  .tag-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }

  a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem;
    font: 700 0.85rem/1.4 var(--mono);
    text-decoration: none;
  }

  a > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  a:hover {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  small {
    color: var(--muted);
  }

  @media (max-width: 38rem) {
    .tag-index {
      grid-template-columns: 1fr;
    }

    li:nth-child(odd) {
      border-right: 0;
    }
  }
</style>
