---
import '../styles/global.css';
import { getImage, Image } from 'astro:assets';
import { siteConfig } from '../config/site';
import favicon from '../assets/brand/favicon-cropped.png';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const documentTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site) : undefined;
const [browserIcon, touchIcon] = await Promise.all([
  getImage({ src: favicon, width: 64, height: 64, format: 'png' }),
  getImage({ src: favicon, width: 180, height: 180, format: 'png' }),
]);

const navigation = [
  { href: '/', label: 'Início' },
  { href: '/projetos/', label: 'Projetos' },
  { href: '/blog/', label: 'Blog' },
  { href: '/pensamentos/', label: 'Pensamentos' },
  { href: '/sobre/', label: 'Sobre' },
  { href: '/contato/', label: 'Contato' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === href : pathname.startsWith(href);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1e8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" sizes="64x64" href={browserIcon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon.src} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="site-frame">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Página inicial">
          <Image src={favicon} alt="" width={30} height={30} format="webp" quality={80} />
          <span>{siteConfig.shortTitle}</span>
        </a>
        <nav aria-label="Navegação principal">
          {navigation.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </header>

      <main id="conteudo">
        <slot />
      </main>

      <footer class="site-footer">
        <span>{siteConfig.name} · Rio de Janeiro</span>
        <span class="footer-links">
          <a href={siteConfig.links.github} rel="me">GitHub</a>
          <a href={siteConfig.links.linkedin} rel="me">LinkedIn</a>
          <span>Jardim digital · {new Date().getFullYear()}</span>
        </span>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-frame {
    width: min(78rem, calc(100% - 3rem));
    min-height: 100vh;
    margin: 0 auto;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 0.9rem;
    color: var(--paper-raised);
    background: var(--ink);
    font: 700 0.8rem/1 var(--ui);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    font: 700 0.7rem/1.4 var(--mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex: none;
    color: var(--ink);
    font-size: 0.84rem;
    text-decoration: none;
  }

  .wordmark :global(img) {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 0.45rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1.35rem;
  }

  nav a {
    position: relative;
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -0.65rem;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-50%);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    border-bottom: 0;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1rem;
  }

  .footer-links a {
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 46rem) {
    .site-frame {
      width: min(100% - 2rem, 42rem);
    }

    .site-header {
      align-items: flex-start;
    }

    nav {
      max-width: 20rem;
    }
  }

  @media (max-width: 32rem) {
    .site-header {
      display: grid;
      gap: 1rem;
    }

    nav {
      justify-content: flex-start;
    }

    .footer-links > span {
      display: none;
    }
  }
</style>
