---
import BaseLayout from './BaseLayout.astro';
import { formatDate, statusLabels } from '../lib/content';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  kind: 'Projeto' | 'Artigo' | 'Pensamento';
  status?: keyof typeof statusLabels;
  backHref: string;
  backLabel: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  tags = [],
  kind,
  status,
  backHref,
  backLabel,
} = Astro.props;
---

<BaseLayout title={title} description={description} type={kind === 'Artigo' ? 'article' : 'website'} publishedAt={publishedAt} updatedAt={updatedAt}>
  <article class="entry-shell">
    <a class="back" href={backHref}>← {backLabel}</a>

    <header class="entry-header">
      <h1>{title}</h1>
      <p>{description}</p>
    </header>

    <div class="entry-meta">
      <span class="kind">{kind}</span>
      {status && <span class="status"><i></i>{statusLabels[status]}</span>}
      <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
    </div>


    <slot name="details" />

    <div class:list={['prose', { 'prose--article': kind === 'Artigo' }]}>
      <slot />
    </div>

    {kind === 'Projeto' && (
      <aside class="project-contact" aria-labelledby="project-contact-title">
        <h2 id="project-contact-title">Tem um problema parecido?</h2>
        <p>Vamos conversar sobre IA, dados ou automação no seu projeto.</p>
        <a href={siteConfig.links.linkedin}>Conversar pelo LinkedIn <span aria-hidden="true">↗</span></a>
      </aside>
    )}

    <footer class="entry-footer">
      {updatedAt && <p>Atualizado em {formatDate(updatedAt)}</p>}
      {tags.length > 0 && (
        <ul aria-label="Tags">
          {tags.map((tag) => <li><a href={`/tags/${tag}/`}>#{tag}</a></li>)}
        </ul>
      )}
    </footer>
  </article>
</BaseLayout>

<style>
  .entry-shell {
    width: min(46rem, 100%);
    margin: 0 auto;
    padding: 3rem 0 7rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted);
    font: 700 0.72rem/1.4 var(--mono);
    letter-spacing: 0.06em;
    text-underline-offset: 0.25em;
    text-transform: uppercase;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0 0 2rem;
    padding: 0.75rem 0;
    border-top: 0.2rem solid var(--accent);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font: 700 0.67rem/1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .kind {
    margin-right: auto;
    color: var(--ink);
  }

  .status i {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .entry-header p {
    max-width: 44rem;
    margin: 1.5rem 0 2rem;
    color: var(--ink-soft);
    font-size: clamp(1.2rem, 2.8vw, 1.55rem);
    line-height: 1.55;
  }

  .entry-header h1 {
    max-width: 24ch;
    margin: 3rem 0 2rem;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  :global(.prose h2) {
    margin: 3rem 0 1rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  :global(.prose p),
  :global(.prose li) {
    max-width: 66ch;
    color: var(--ink-soft);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  :global(.prose--article p),
  :global(.prose--article li) {
    hyphens: auto;
    text-align: justify;
  }

  :global(.prose--article > p) {
    text-indent: 1.5em;
  }

  :global(.prose a) {
    color: var(--accent-strong);
    text-underline-offset: 0.2em;
  }

  :global(.prose code) {
    padding: 0.12em 0.3em;
    border-radius: 0.25rem;
    color: var(--code-ink);
    background: var(--code);
    font-family: var(--mono);
    font-size: 0.9em;
  }

  :global(.prose pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1.25rem;
    border-radius: 0.25rem;
    color: var(--code-ink);
    background: var(--code);
  }

  :global(.prose pre code) {
    padding: 0;
  }

  :global(.prose p), :global(.prose li) {
    overflow-wrap: anywhere;
  }

  :global(.prose figure) {
    margin: 2.75rem 0;
  }

  :global(.prose figure img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    box-shadow: 0.45rem 0.45rem 0 var(--line);
  }

  :global(.prose figcaption) {
    margin-top: 0.85rem;
    color: var(--muted);
    font: 600 0.72rem/1.5 var(--mono);
  }

  :global(.prose blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 0.25rem solid var(--accent);
  }

  :global(.prose blockquote p) {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
  }

  :global(.prose table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 2rem 0;
    border-collapse: collapse;
    font: 600 0.78rem/1.5 var(--mono);
  }

  :global(.prose th),
  :global(.prose td) {
    padding: 0.75rem 0.8rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }

  :global(.prose th) {
    color: var(--ink);
    background: var(--paper-raised);
  }

  @media (min-width: 64rem) {
    :global(.prose .wide-figure) {
      width: min(60rem, calc(100vw - 3rem));
      margin-left: 50%;
      transform: translateX(-50%);
    }
  }

  .project-contact { margin-top: 3rem; padding: 1.5rem; border: 1px solid var(--line); background: var(--accent-soft); }
  .project-contact h2 { margin: 0; font-size: 1.6rem; font-weight: 500; }
  .project-contact p { color: var(--ink-soft); line-height: 1.6; }
  .project-contact a { display: inline-flex; gap: 0.7rem; align-items: center; min-height: 2.75rem; color: var(--accent-strong); font: 700 0.85rem/1.5 var(--ui); text-underline-offset: 0.25em; }

  .entry-footer {
    margin-top: 4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font: 600 0.72rem/1.5 var(--mono);
  }

  .entry-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .entry-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--accent-strong);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 34rem) {
    .entry-shell {
      padding: 2rem 0 4.5rem;
    }

    .entry-meta {
      margin-top: 0;
    }

    .entry-header h1 {
      margin: 1.5rem 0 1rem;
      font-size: clamp(2rem, 8vw, 3rem);
    }

    .entry-header p { font-size: 1.1rem; }
    .entry-meta { font-size: 0.75rem; }
    .project-contact { padding: 1rem; }
    .project-contact a { flex-wrap: wrap; }
    :global(.prose--article p), :global(.prose--article li) {
      text-align: start;
    }

    :global(.prose p),
    :global(.prose li) {
      font-size: 1.05rem;
    }

    :global(.prose--article > p) {
      text-indent: 1.25em;
    }

    :global(.prose figure) {
      margin: 2rem 0;
    }

    :global(.prose figure img) {
      box-shadow: 0.3rem 0.3rem 0 var(--line);
    }

    :global(.prose blockquote) {
      padding-left: 1rem;
    }
  }
</style>
